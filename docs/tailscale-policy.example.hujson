{
  // Home Music — policy mínima para um tailnet pessoal/dedicado.
  //
  // IMPORTANTE:
  // - combine estas seções com qualquer regra que você realmente precise manter;
  // - grants e ACLs são aditivos: um allow-all existente continua liberando acesso;
  // - só remova regras amplas depois de aplicar tag:home-music ao Ubuntu e validar acesso.

  "tagOwners": {
    "tag:home-music": ["autogroup:admin"],
  },

  // Funnel deve ser permitido somente no servidor Home Music.
  // Remova um nodeAttrs anterior que conceda "funnel" a autogroup:member/*.
  "nodeAttrs": [
    {
      "target": ["tag:home-music"],
      "attr": ["funnel"],
    },
  ],

  "grants": [
    // Preserva a conectividade normal entre dispositivos pessoais do mesmo usuário.
    // Dispositivos tagueados não pertencem a autogroup:self, então este grant NÃO
    // reabre outras portas do servidor Home Music depois que a tag for aplicada.
    {
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "ip": ["*"],
    },

    // O servidor Home Music recebe somente HTTPS dentro do tailnet.
    {
      "src": ["autogroup:member"],
      "dst": ["tag:home-music"],
      "ip": ["tcp:443"],
    },
  ],

  // Mantém a regra padrão de Tailscale SSH apenas para dispositivos pessoais.
  // Depois que o Ubuntu recebe tag:home-music, ele deixa de ser autogroup:self;
  // portanto Tailscale SSH para o servidor fica deliberadamente bloqueado.
  "ssh": [
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"],
    },
  ],
}
