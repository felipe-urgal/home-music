# Pasta do Ubuntu onde estão as músicas.
# Use aspas quando o caminho tiver espaços.
# Exemplo simples:
# MUSIC_DIR=/home/seu-usuario/Music
# Exemplo com espaços:
# MUSIC_DIR="/mnt/musicas/Musicas - Copia"
MUSIC_DIR="/home/seu-usuario/Music"

# Caminho opcional do SQLite principal. Se omitido, usa data/home-music.db.
# O mesmo caminho é usado pelo servidor, bootstrap, backup/restore e recuperação local.
# HOME_MUSIC_DATABASE_PATH=/home/seu-usuario/.local/share/home-music/home-music.db

# Staging temporário das importações. Deve ficar fora de MUSIC_DIR.
# Para a promoção atômica/no-clobber desta fase, mantenha staging e MUSIC_DIR
# no mesmo filesystem. Se omitido, o Home Music usa data/import-staging.
# HOME_MUSIC_IMPORT_STAGING_DIR=/home/seu-usuario/.local/share/home-music/import-staging

# TTL de workspaces órfãos do staging, em horas.
# Padrão: 24. Valores aceitos: 1 a 720.
HOME_MUSIC_IMPORT_STAGING_TTL_HOURS=24

# Limite por arquivo enviado pela tela Importar mídia, em MB.
# Padrão: 512. Valores aceitos: 1 a 8192.
HOME_MUSIC_IMPORT_UPLOAD_MAX_MB=512

# Limite por arquivo baixado por URL direta, em MB.
# Padrão: 512. Valores aceitos: 1 a 8192.
HOME_MUSIC_IMPORT_URL_MAX_MB=512

# Timeout total da importação por URL, em segundos.
# Padrão: 120. Valores aceitos: 5 a 900.
HOME_MUSIC_IMPORT_URL_TIMEOUT_SECONDS=120

# Máximo de redirects HTTP/HTTPS seguidos pela importação por URL.
# Cada destino é revalidado contra SSRF antes da conexão.
# Padrão: 3. Valores aceitos: 0 a 10.
HOME_MUSIC_IMPORT_URL_MAX_REDIRECTS=3

# Provider opcional para YouTube Music e sites compatíveis.
# O servidor autodetecta yt-dlp em /usr/local/bin/yt-dlp, /usr/bin/yt-dlp e
# ~/.local/bin/yt-dlp. Defina somente se o executável estiver em outro caminho.
# O caminho, quando informado, deve ser absoluto e executável.
# HOME_MUSIC_YT_DLP_PATH=/usr/local/bin/yt-dlp

# Scratch temporário dos providers externos. Deve ficar fora de MUSIC_DIR.
# Se omitido, o Home Music usa data/provider-scratch.
# HOME_MUSIC_EXTERNAL_PROVIDER_SCRATCH_DIR=/home/seu-usuario/.local/share/home-music/provider-scratch

# Atualização automática da biblioteca em segundos.
# Padrão: 0 (desativado). Para habilitar, use um valor entre 60 e 86400.
# Exemplo: 300 = a cada 5 minutos.
HOME_MUSIC_RESCAN_INTERVAL_SECONDS=0

# Binário opcional do FFmpeg. Se omitido, o Home Music procura `ffmpeg` no PATH.
# O streaming original continua funcionando mesmo se FFmpeg estiver indisponível.
# Exemplo: HOME_MUSIC_FFMPEG_PATH=/usr/bin/ffmpeg
HOME_MUSIC_FFMPEG_PATH=ffmpeg

# Binário do FFprobe usado na validação técnica das importações.
# Se omitido, usa `ffprobe` no PATH. Quando HOME_MUSIC_FFMPEG_PATH aponta para
# um caminho completo, o servidor procura `ffprobe` no mesmo diretório.
# Exemplo: HOME_MUSIC_FFPROBE_PATH=/usr/bin/ffprobe
# HOME_MUSIC_FFPROBE_PATH=ffprobe

# Limite do cache local de músicas transcodificadas, em MB.
# Padrão: 512. Valores aceitos: 64 a 8192.
HOME_MUSIC_TRANSCODE_CACHE_MB=512

# Credenciais SOMENTE para o primeiro bootstrap do administrador.
# Defina estas duas variáveis antes do primeiro start. Assim que o admin estiver
# persistido no SQLite e o login for confirmado, remova ambas do .env.
# Logins normais e o Tailscale Funnel não dependem delas após o bootstrap.
HOME_MUSIC_USER=home-music
HOME_MUSIC_PASSWORD=

# Em HTTP local deixe false.
# Os perfis HTTPS via Tailscale Serve/Funnel alteram para true somente com
# o backend restrito a loopback e restauram a configuração em caso de falha.
HOME_MUSIC_COOKIE_SECURE=false

# Permite usar X-Forwarded-For somente quando o Fastify recebe a conexão por
# loopback em produção HTTPS. Não habilite manualmente para proxies genéricos;
# o fluxo de Tailscale Funnel configura esta flag de forma transacional.
HOME_MUSIC_TRUST_TAILSCALE_PROXY=false

# Porta única usada pelo backend e, em produção, também pelo frontend compilado.
PORT=8787

# Desenvolvimento: a API fica somente nesta máquina e o Vite faz proxy de /api.
HOST=127.0.0.1

# Destino opcional do proxy /api do Vite em desenvolvimento.
# Padrão: http://127.0.0.1:8787. O Docker Compose define http://server:8787.
# VITE_PROXY_TARGET=http://127.0.0.1:8787

# Produção em LAN: 0.0.0.0 permite acesso direto por http://IP_DO_PC:8787.
# Produção com Tailscale Serve/Funnel: os scripts alteram para 127.0.0.1,
# deixando o Fastify inacessível diretamente pela LAN/tailnet/internet.
PRODUCTION_HOST=0.0.0.0
