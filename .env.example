# Pasta do Ubuntu onde estão as músicas.
# Use aspas quando o caminho tiver espaços.
# Exemplo simples:
# MUSIC_DIR=/home/seu-usuario/Music
# Exemplo com espaços:
# MUSIC_DIR="/run/media/seu-usuario/disco/Musicas - Copia"
MUSIC_DIR="/home/seu-usuario/Music"

# Backend
PORT=8787
HOST=0.0.0.0

# Frontend
# Deixe VITE_API_URL vazio para usar /api no mesmo host do app.
# Isso funciona melhor no celular via Wi-Fi/Tailscale.
VITE_API_URL=
