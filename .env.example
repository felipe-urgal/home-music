# Pasta do Ubuntu onde estão as músicas.
# Use aspas quando o caminho tiver espaços.
# Exemplo simples:
# MUSIC_DIR=/home/seu-usuario/Music
# Exemplo com espaços:
# MUSIC_DIR="/run/media/seu-usuario/disco/Musicas - Copia"
MUSIC_DIR="/home/seu-usuario/Music"

# Acesso pelo navegador/celular na rede local.
# Use uma senha exclusiva, com pelo menos 12 caracteres.
HOME_MUSIC_USER=home-music
HOME_MUSIC_PASSWORD=troque-por-uma-senha-forte

# Backend
PORT=8787
# Em desenvolvimento, a API fica acessível somente nesta máquina.
# O celular acessa /api pelo frontend autenticado em :5173.
HOST=127.0.0.1
