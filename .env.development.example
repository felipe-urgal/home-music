# Ambiente de desenvolvimento isolado do Home Music.
# Copie para .env.development antes de rodar npm run dev.
# Os paths relativos abaixo são resolvidos a partir de apps/server pelo npm workspace.

# Biblioteca pequena/de teste no checkout. Não aponte o DEV para a biblioteca real de produção.
MUSIC_DIR="../../music-dev"

# SQLite exclusivo do DEV.
HOME_MUSIC_DATABASE_PATH="../../data/development/home-music.db"

# Diretórios temporários exclusivos do DEV e fora de MUSIC_DIR.
HOME_MUSIC_IMPORT_STAGING_DIR="../../data/development/import-staging"
HOME_MUSIC_EXTERNAL_PROVIDER_SCRATCH_DIR="../../data/development/provider-scratch"

HOME_MUSIC_IMPORT_STAGING_TTL_HOURS=24
HOME_MUSIC_IMPORT_UPLOAD_MAX_MB=512
HOME_MUSIC_IMPORT_URL_MAX_MB=512
HOME_MUSIC_IMPORT_URL_TIMEOUT_SECONDS=120
HOME_MUSIC_IMPORT_URL_MAX_REDIRECTS=3

# Providers opcionais.
# HOME_MUSIC_YT_DLP_PATH=/usr/local/bin/yt-dlp
# HOME_MUSIC_JAMENDO_CLIENT_ID=seu-client-id-dev

HOME_MUSIC_RESCAN_INTERVAL_SECONDS=0
HOME_MUSIC_SCAN_CONCURRENCY=4
HOME_MUSIC_FFMPEG_PATH=ffmpeg
# HOME_MUSIC_FFPROBE_PATH=ffprobe
HOME_MUSIC_TRANSCODE_CACHE_MB=512

HOME_MUSIC_HEAVY_WORK_RETRY_AFTER_SECONDS=2
HOME_MUSIC_TRANSCODE_MAX_CONCURRENT=1
HOME_MUSIC_TRANSCODE_MAX_PENDING=12
HOME_MUSIC_TRANSCODE_MAX_PENDING_PER_USER=4
HOME_MUSIC_COVER_MAX_CONCURRENT=4
HOME_MUSIC_COVER_MAX_PENDING=32
HOME_MUSIC_COVER_MAX_PENDING_PER_USER=8
HOME_MUSIC_IMPORT_MAX_NON_TERMINAL=16
HOME_MUSIC_IMPORT_MAX_NON_TERMINAL_PER_USER=8
HOME_MUSIC_INTEGRITY_MAX_PENDING=2
HOME_MUSIC_INTEGRITY_MAX_PENDING_PER_USER=1

# Somente para criar o primeiro admin do banco DEV.
# A senha precisa ter pelo menos 12 caracteres.
# Depois do primeiro login, remova as duas linhas do .env.development.
HOME_MUSIC_USER=home-music-dev
HOME_MUSIC_PASSWORD=

HOME_MUSIC_COOKIE_SECURE=false
HOME_MUSIC_TRUST_TAILSCALE_PROXY=false

# DEV usa porta própria para coexistir com o systemd de produção em :8787.
PORT=8788
HOST=127.0.0.1
VITE_PROXY_TARGET=http://127.0.0.1:8788

# Não é usado pelo servidor em NODE_ENV=development, mas fica explícito para evitar confusão.
PRODUCTION_HOST=0.0.0.0
