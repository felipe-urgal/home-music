{
  "name": "@home-music/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:security": "tsx --test src/*security*.test.ts",
    "benchmark:large-library": "node --expose-gc --import tsx src/large-library.benchmark.ts",
    "ffmpeg:status": "tsx src/ffmpeg-cli.ts",
    "admin:recover": "tsx src/admin-recovery-cli.ts",
    "backup:create": "tsx src/backup-cli.ts create",
    "backup:verify": "tsx src/backup-cli.ts verify",
    "backup:restore": "tsx src/backup-cli.ts restore",
    "smoke:backup-restore": "tsx src/backup-restore-smoke.ts",
    "start": "node --import ./dist/bootstrap-preload.js dist/index.js"
  },
  "dependencies": {
    "@home-music/shared": "0.1.0",
    "dotenv": "17.2.1",
    "fastify": "5.12.1",
    "music-metadata": "11.15.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.23.12",
    "typescript": "5.9.2"
  }
}
