{
  "name": "@home-music/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-pwa-icons.mjs && vite --host 0.0.0.0",
    "build": "node scripts/generate-pwa-icons.mjs && tsc -b && vite build && node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node scripts/generate-pwa-icons.mjs && vitest run --exclude src/large-library.performance.test.tsx",
    "benchmark:large-library": "vitest run src/large-library.performance.test.tsx"
  },
  "dependencies": {
    "@home-music/shared": "0.1.0",
    "lucide-react": "0.542.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
