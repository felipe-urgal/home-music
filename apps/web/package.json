{
  "name": "@home-music/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-pwa-icons.mjs && vite --host 0.0.0.0",
    "build": "node scripts/generate-pwa-icons.mjs && tsc -b && vite build && node scripts/check-bundle-budget.mjs && npm run build:tv-receiver",
    "build:tv-receiver": "vite build --config vite.tv-offline-receiver.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "node scripts/generate-pwa-icons.mjs && vitest run --exclude src/large-library.performance.test.tsx",
    "benchmark:large-library": "vitest run src/large-library.performance.test.tsx"
  },
  "dependencies": {
    "@home-music/shared": "0.1.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
